{
    "name":  "claude-office",
    "version":  "1.0.0",
    "description":  "Pixel office for Claude Code sessions",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "dist":  "electron-builder --win portable"
                },
    "keywords":  [

                 ],
    "author":  "",
    "license":  "ISC",
    "type":  "commonjs",
    "dependencies":  {
                         "@lydell/node-pty":  "^1.2.0-beta.15",
                         "@xterm/addon-fit":  "^0.11.0",
                         "@xterm/addon-web-links":  "^0.12.0",
                         "@xterm/xterm":  "^6.0.0"
                     },
    "devDependencies":  {
                            "electron":  "^44.9.0",
                            "electron-builder":  "^26.15.3"
                        },
    "build":  {
                  "appId":  "ai.plbx.claude-office",
                  "productName":  "Claude Office",
                  "files":  [
                                "main.js",
                                "preload.js",
                                "renderer/**",
                                "build/icon.png",
                                "node_modules/**"
                            ],
                  "asarUnpack":  [
                                     "node_modules/@lydell/**"
                                 ],
                  "win":  {
                              "target":  "portable",
                              "icon":  "build/icon.png"
                          },
                  "portable":  {
                                   "artifactName":  "ClaudeOffice.exe"
                               },
                  "directories":  {
                                      "output":  "dist"
                                  }
              }
}
